{
  "name": "ReferralLink",
  "type": "object",
  "properties": {
    "url": {
      "type": "string",
      "description": "Referen\u010dn\u00ed URL odkaz"
    },
    "title": {
      "type": "string",
      "description": "N\u00e1zev slu\u017eby nebo \u010dl\u00e1nku"
    },
    "description": {
      "type": "string",
      "description": "Kr\u00e1tk\u00fd popis nebo bonus info"
    },
    "content": {
      "type": "string",
      "description": "Obsah \u010dl\u00e1nku (dlouh\u00fd text)"
    },
    "image_url": {
      "type": "string",
      "description": "URL n\u00e1hledov\u00e9ho obr\u00e1zku"
    },
    "cta_text": {
      "type": "string",
      "description": "Text na tla\u010d\u00edtku CTA"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "crypto",
          "banks",
          "cashback",
          "games",
          "apps",
          "other",
          "clanek",
          "N\u00e1kup levn\u011b"
        ]
      },
      "description": "Kategorie"
    },
    "is_article": {
      "type": "boolean",
      "default": false,
      "description": "P\u0159\u00edznak, zda jde o \u010dl\u00e1nek (true) nebo odkaz (false)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Zda je z\u00e1znam aktivn\u00ed"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Po\u0159ad\u00ed"
    }
  },
  "required": [
    "title"
  ]
}